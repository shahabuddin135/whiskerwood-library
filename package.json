{
  "name": "whiskerwood-library",
  "private": true,
  "version": "1.1.0",
  "description": "Whiskerwood Library - a cozy idle expansion game where mice run a library.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "simulate": "node scripts/simulate.mjs",
    "cap:sync": "vite build && npx cap sync",
    "android": "vite build && npx cap sync android && npx cap open android",
    "ios": "vite build && npx cap sync ios && npx cap open ios",
    "store-assets": "node scripts/store-assets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "android:release": "vite build && npx cap sync android && cd android && gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/kalam": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.1"
  }
}
